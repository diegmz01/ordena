# JWT
JWT_SECRET=dev-jwt-secret-change-me-ordena

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/ordena
# Solo si usas docker-compose.yml para Postgres local: deben coincidir con
# el usuario/password/db de arriba en DATABASE_URL. Cambia la password acá
# si no quieres usar la de ejemplo (docker-compose la toma de estas vars).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=ordena

# API
API_PORT=4000
API_URL=http://localhost:4000
# Error tracking (opcional): sin esto, la API no manda nada a ningún lado,
# solo loguea a consola como siempre. Crea un proyecto Node en sentry.io y
# pega el DSN acá para activarlo.
SENTRY_DSN=
TZ=America/Mexico_City

# URLs públicas (CORS)
CUSTOMER_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
BRANCH_URL=http://localhost:3002

# Apps Next.js
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CUSTOMER_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_BRANCH_URL=http://localhost:3002

# Stripe: una sola cuenta de plataforma. Todos los pedidos de todas las
# sucursales capturan aquí — no hay cuenta ni onboarding por sucursal.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Web Push (PWA clientes) — genera con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ordena.local

# OAuth clientes (Google / Facebook) — callbacks en la API
OAUTH_REDIRECT_BASE=http://localhost:4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Restablecer contraseña (clientes): clave para cifrar la contraseña SMTP
# guardada en base de datos (Admin > Configuración). Genera con:
# openssl rand -base64 32
SMTP_ENCRYPTION_KEY=

# Seed
# Solo desarrollo. En production el seed aborta (NODE_ENV=production).
DEV_AUTH_PASSWORD=OrdenaDev2026!
