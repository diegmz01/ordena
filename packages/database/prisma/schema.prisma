// Ordena — single restaurant, multiple branches

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  BRANCH_STAFF
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OAuthProvider {
  GOOGLE
  FACEBOOK
}

enum BranchAvailability {
  AUTO
  OPEN
  PAUSED
  CLOSED
}

/** Motivo de ausencia de la PWA staff. */
enum StaffAwayReason {
  APP_CLOSED
  CONNECTION_LOST
}

/** FIXED = monto fijo en centavos. PERCENTAGE = % del subtotal (basis points). */
enum ServiceFeeType {
  FIXED
  PERCENTAGE
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String               @unique
  passwordHash        String?
  image               String?
  role                Role                 @default(CUSTOMER)
  phone               String?
  branchId            String?
  branch              Branch?              @relation(fields: [branchId], references: [id])
  orders              Order[]
  pushSubscriptions   PushSubscription[]
  oauthAccounts       OAuthAccount[]
  adminAuditLogs      AdminAuditLog[]
  passwordResetTokens PasswordResetToken[]
  refunds             Refund[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model OAuthAccount {
  id                String        @id @default(cuid())
  provider          OAuthProvider
  providerAccountId String
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Token de un solo uso para restablecer contraseña de clientes (login por
/// correo). Se guarda el hash (SHA-256) del token, no el valor en claro,
/// porque a diferencia de OAuthOneTimeCode este viaja por email y vive minutos.
model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

/// Configuración SMTP del negocio (fila única) usada para enviar correos de
/// restablecimiento de contraseña a clientes. Editable desde el admin.
model SmtpSettings {
  id                String   @id @default("singleton")
  host              String
  port              Int      @default(587)
  secure            Boolean  @default(false)
  username          String?
  /// Contraseña SMTP cifrada (AES-256-GCM), nunca en claro.
  encryptedPassword String?
  fromEmail         String
  fromName          String?
  updatedAt         DateTime @updatedAt
}

/// Tarifa de servicios global (fila única), sumada al total de todo pedido en
/// cualquier sucursal. Editable desde admin. El monto/porcentaje vigente al
/// pagar se congela en `Order.serviceFee` para no alterar pedidos ya creados
/// si el admin cambia la tarifa después.
model ServiceFeeSettings {
  id         String         @id @default("singleton")
  type       ServiceFeeType @default(FIXED)
  /// Monto fijo en centavos (MXN * 100), usado si type = FIXED.
  amount     Int            @default(0)
  /// Porcentaje del subtotal en basis points (1/100 de 1%; 250 = 2.50%), usado si type = PERCENTAGE.
  percentage Int            @default(0)
  isActive   Boolean        @default(false)
  updatedAt  DateTime       @updatedAt
}

model Branch {
  id           String             @id @default(cuid())
  name         String
  slug         String             @unique
  address      String
  phone        String?
  latitude     Float?
  longitude    Float?
  isActive     Boolean            @default(true)
  availability    BranchAvailability @default(AUTO)
  pausedUntil     DateTime?
  /** Último heartbeat de la PWA staff; si caduca, no se aceptan pedidos. */
  staffLastSeenAt DateTime?
  /** APP_CLOSED = staff cerró la app; CONNECTION_LOST = red/API sin señal de cierre. */
  staffAwayReason StaffAwayReason?
  prepTimeMinutes Int                @default(20)
  /** Si true, el staff puede gestionar stock (agotar productos) desde la PWA. */
  menuStockEnabled Boolean           @default(false)
  hours           Json?
  staff        User[]
  products     BranchProduct[]
  categories   BranchCategory[]
  modifiers    BranchModifier[]
  orders       Order[]
  pushSubscriptions PushSubscription[]
  statusEvents      BranchStatusEvent[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

/// Bitácora de cambios de estado efectivo de una sucursal (abierta/pausada/
/// cerrada, y por qué: horario, manual, o presencia de staff perdida). Se
/// inserta una fila solo cuando el estado cambia (ver
/// apps/api/src/jobs/branch-status-snapshot-job.ts), para reconstruir un
/// resumen mensual de "tiempo abierto" y "problemas de conexión" en admin.
/// Best-effort: si el job no corrió (proceso caído), ese lapso queda como un
/// hueco sin registrar.
model BranchStatusEvent {
  id             String   @id @default(cuid())
  branchId       String
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  /// "OPEN" | "PAUSED" | "CLOSED" (EffectiveAvailability.status)
  status         String
  /// "schedule" | "manual" | "pause" | "offline" (EffectiveAvailability.source)
  source         String
  /// "app_closed" | "connection_lost", solo cuando source = "offline"
  offlineCause   String?
  withinSchedule Boolean
  createdAt      DateTime @default(now())

  @@index([branchId, createdAt])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  products  Product[]
  branches  BranchCategory[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Contenido de páginas estáticas del sitio de cliente (aviso de privacidad,
/// términos y condiciones). Una fila fija por slug, editada desde admin.
model SiteContent {
  id        String   @id
  title     String
  content   String   @db.Text
  updatedAt DateTime @updatedAt
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  imageUrl    String?
  basePrice   Int
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  /// Si es true, el cliente puede combinarlo con otro producto de la misma
  /// categoría (dos productos por línea, precio = el más caro + modificador).
  allowCombo  Boolean          @default(false)
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  modifiers   ProductModifier[]
  branches    BranchProduct[]
  orderItems  OrderItem[]
  comboOrderItems OrderItem[]  @relation("OrderItemSecondaryProduct")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProductVariant {
  id         String   @id @default(cuid())
  name       String
  priceDelta Int      @default(0)
  isActive   Boolean  @default(true)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Extra reutilizable (ej. Extra queso +$20) asignable a varios productos.
model Modifier {
  id         String           @id @default(cuid())
  name       String
  slug       String           @unique
  /// Incremento de precio en centavos (MXN * 100).
  priceDelta Int              @default(0)
  sortOrder  Int              @default(0)
  /// Si es false, el cliente decide agregarlo o no. Si es true, va incluido.
  isRequired Boolean          @default(false)
  isActive   Boolean          @default(true)
  products   ProductModifier[]
  branches   BranchModifier[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model ProductModifier {
  id         String   @id @default(cuid())
  productId  String
  modifierId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifier   Modifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([productId, modifierId])
}

model BranchProduct {
  id               String    @id @default(cuid())
  branchId         String
  productId        String
  /** Admin: si la sucursal vende este producto (catálogo de la sucursal). */
  available        Boolean   @default(true)
  /** Staff: agotado temporal; null = con stock. No cambia `available`. */
  unavailableUntil DateTime?
  /** Admin: horario semanal en el que el producto aparece disponible (mismo shape que Branch.hours). null = sin restricción. */
  schedule         Json?
  branch           Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
}

/** Admin: horario semanal aplicado a todos los productos de una categoría en una
  * sucursal (mismo shape que Branch.hours). Si está definido, tiene prioridad
  * sobre `BranchProduct.schedule` y bloquea la edición de horario por producto
  * dentro de esa categoría. null = sin horario de categoría (cada producto
  * conserva su propio horario, si tiene). */
model BranchCategory {
  id         String   @id @default(cuid())
  branchId   String
  categoryId String
  schedule   Json?
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([branchId, categoryId])
}

/** Staff: agotado temporal de un modificador en una sucursal. Sin fila = con stock. */
model BranchModifier {
  id               String    @id @default(cuid())
  branchId         String
  modifierId       String
  /** Staff: agotado temporal; null = con stock. */
  unavailableUntil DateTime?
  branch           Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  modifier         Modifier  @relation(fields: [modifierId], references: [id], onDelete: Cascade)

  @@unique([branchId, modifierId])
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  /// Token opaco para tracking de invitados (no adivinar por id)
  viewToken             String      @unique @default(cuid())
  /// Key idempotente generada por el cliente al iniciar el checkout; evita
  /// crear pedidos/Stripe Sessions duplicados por doble submit o retry de red.
  idempotencyKey        String?     @unique
  status                OrderStatus @default(PENDING_PAYMENT)
  branchId              String
  branch                Branch      @relation(fields: [branchId], references: [id])
  userId                String?
  user                  User?       @relation(fields: [userId], references: [id])
  guestName             String?
  guestEmail            String?
  guestPhone            String?
  subtotal              Int
  /// Suma de lineTotal de ítems marcados agotados (centavos)
  discount              Int         @default(0)
  /// Tarifa de servicios vigente al pagar, congelada del ServiceFeeSettings
  /// singleton (centavos). No cambia si el admin ajusta la tarifa después.
  serviceFee            Int         @default(0)
  /// subtotal - discount + serviceFee (monto a capturar en Stripe)
  total                 Int
  currency              String      @default("mxn")
  stripeSessionId       String?     @unique
  stripePaymentIntentId String?
  /// Marca de tarjeta (visa, mastercard, …)
  paymentBrand          String?
  /// funding de Stripe: credit | debit | prepaid | unknown
  paymentFunding        String?
  /// Últimos 4 dígitos
  paymentLast4          String?
  /// Número de ticket en la PTV (pantalla / cocina)
  ptvTicket             Int?
  /// Consecutivo del día por sucursal (#1, #2…); se reinicia cada día
  dayNumber             Int?
  /// Día operativo (calendario local) asociado a dayNumber
  businessDate          DateTime?   @db.Date
  /// Minutos de preparación asignados al iniciar prep
  prepMinutes           Int?
  /// Momento en que el pedido debe pasar a READY
  readyAt               DateTime?
  /// Código de entrega (4 dígitos) generado al pasar a READY; el cliente lo
  /// debe dar en sucursal para que staff marque el pedido como COMPLETED.
  pickupCode            String?
  notes                 String?
  /// Motivo obligatorio ingresado por sucursal o admin al cancelar el pedido
  cancellationReason    String?
  /// True si fue el propio cliente quien canceló (vs. staff/admin/sistema).
  /// Mientras sea true y `customerCancelAckedAt` sea null, el pedido sigue
  /// apareciendo en "pedidos en vivo" de sucursal para que el staff no
  /// continúe preparándolo sin darse cuenta.
  cancelledByCustomer   Boolean     @default(false)
  /// Cuándo el staff marcó "Entendido" sobre una cancelación hecha por el
  /// cliente. Null = todavía debe reconocerla.
  customerCancelAckedAt DateTime?
  /// Suma de reembolsos parciales de Stripe (centavos); no incluye la
  /// cancelación total del pedido, que se refleja vía `status = CANCELLED`.
  refundedTotal         Int         @default(0)
  items                 OrderItem[]
  refunds               Refund[]
  paidAt                DateTime?
  /// Momento en que el pedido pasó a ACCEPTED (o directo a PREPARING vía
  /// /accept, que salta ACCEPTED por transitorio; en ese caso coincide con
  /// preparingAt). Usado para medir tiempos entre pasos del flujo.
  acceptedAt            DateTime?
  /// Momento en que el pedido pasó a PREPARING.
  preparingAt           DateTime?
  /// Momento en que el pedido realmente pasó a READY (no confundir con
  /// `readyAt`, que es el momento programado en que debe pasar a READY).
  readyReachedAt        DateTime?
  /// Momento en que el pedido pasó a COMPLETED.
  completedAt           DateTime?
  /// Última vez que se envió un push de "pedido nuevo/urgente" a staff
  /// (creación + reenvíos de escalamiento). Se usa para calcular cuándo
  /// toca el próximo reenvío (ver escalate-unaccepted-orders.ts).
  lastStaffAlertAt      DateTime?
  /// Se envía una sola vez cuando el pedido lleva PAID_ORDER_DELAY_ALERT_MS
  /// sin aceptar (ver handle-stale-paid-orders.ts).
  customerDelayAlertSentAt DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@unique([branchId, businessDate, dayNumber])
  @@index([branchId, status])
  @@index([createdAt])
  @@index([readyAt])
  @@index([paidAt])
  @@index([status, paidAt])
}

/// Carrito + datos de checkout entre "el cliente envía el formulario de pago"
/// y "Stripe confirma el pago". No es un Order: no aparece en el listado de
/// pedidos del admin ni tiene estados — antes se creaba un Order en
/// PENDING_PAYMENT en este punto, lo que ensuciaba el admin con pedidos que
/// nunca se pagaron (el cliente vuelve al menú a agregar más y reintenta).
model PendingCheckout {
  /// Mismo id que tendrá el Order real una vez confirmado el pago —
  /// pre-generado con crypto.randomUUID() en checkout.ts (no @default), para
  /// que el return_url de Stripe ya apunte a /pedido/{id} desde el inicio.
  id              String   @id
  /// Pre-generado con generateViewToken(); se reusa tal cual en el Order real.
  viewToken       String   @unique
  orderNumber     String   @unique
  idempotencyKey  String?  @unique
  branchId        String
  userId          String?
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  subtotal        Int
  serviceFee      Int
  total           Int
  notes           String?
  /// Snapshot de los ítems ya resueltos server-side (producto, combo,
  /// modificadores, precios) — misma forma que espera items.create al crear
  /// el Order real.
  itemsJson       Json
  stripeSessionId String   @unique
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

model OAuthOneTimeCode {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  variantName String?
  /// Producto secundario combinado (mismo categoría, solo el principal
  /// expone modificadores). Null = línea sin combo.
  secondaryProductId   String?
  secondaryProduct     Product? @relation("OrderItemSecondaryProduct", fields: [secondaryProductId], references: [id])
  secondaryProductName String?
  /// Etiqueta visual "Persona 1", "Ana", etc. Null = sin separar
  plateLabel  String?
  unitPrice   Int
  quantity    Int
  lineTotal   Int
  /// Marcado por sucursal: no se prepara ni se cobra
  unavailable Boolean @default(false)
  refundItems RefundItem[]
}

/// Reembolso parcial (uno o varios productos) de un pedido ya cobrado por
/// Stripe, sin cancelar el pedido completo. La cancelación total con
/// devolución íntegra sigue siendo `POST /orders/:id/admin-cancel`.
model Refund {
  id             String       @id @default(cuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Monto reembolsado en este evento (centavos)
  amount         Int
  /// Motivo obligatorio ingresado por el admin
  reason         String
  stripeRefundId String?
  actorId        String
  actor          User         @relation(fields: [actorId], references: [id])
  items          RefundItem[]
  createdAt      DateTime     @default(now())

  @@index([orderId])
}

/// Detalle por producto de un `Refund` (qué línea y cuánta cantidad/monto).
model RefundItem {
  id          String    @id @default(cuid())
  refundId    String
  refund      Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity    Int
  amount      Int

  @@index([refundId])
  @@index([orderItemId])
}

/// Web Push: clientes (pedido) y staff (sucursal / pedidos nuevos)
model PushSubscription {
  id         String   @id @default(cuid())
  endpoint   String   @unique
  p256dh     String
  auth       String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** Staff: push de pedidos nuevos de esta sucursal. */
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orderId    String?
  guestEmail String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([branchId])
  @@index([orderId])
  @@index([guestEmail])
}

/// Registro mínimo de acciones administrativas sensibles (cancelaciones,
/// cambios de precio/menú, cambios de disponibilidad de sucursal) para
/// disputas de cobro e investigación de incidentes. Best-effort: un fallo acá
/// nunca debe bloquear la acción real que se está auditando.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  /// ej. "order.admin_cancel", "product.update", "branch.availability_update"
  action     String
  entityType String
  entityId   String
  /// Detalle puntual de la acción (ej. { from: "PAID", to: "CANCELLED" })
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
